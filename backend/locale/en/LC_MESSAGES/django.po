#: backend/templates/diagnostico.html:13
msgid ""
"Llegar a un diagnóstico correcto de APLV es un proceso que requiere "
"paciencia y la guía de un especialista. No existen pruebas únicas "
"definitivas, sino una combinación de métodos."
msgstr ""

