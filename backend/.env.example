# Development only: copy this file to backend/.env if overrides are needed.
# SQLite is used when DATABASE_URL is omitted.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# DATABASE_URL=sqlite:///db.sqlite3

# Production: inject these through the hosting environment, not a committed file.
# DJANGO_SETTINGS_MODULE=core.settings.production
# Use a strong random value of at least 50 characters; "change-me" will fail.
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=app.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example
# DATABASE_URL=postgresql://user:password@host:5432/database
